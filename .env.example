# --- Database (libSQL). Local file works out of the box; use Turso for Vercel. ---
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Auth (Better Auth). Generate a secret: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- AI service: Nine Router (OpenAI-compatible /chat/completions) ---
# With no AI_API_KEY (or AI_PROVIDER=mock) the app runs on the built-in mock candidate.
AI_PROVIDER=nine-router     # nine-router | mock
AI_BASE_URL=https://9router-production-a99a.up.railway.app/v1
AI_API_KEY=                 # your Nine Router key (sk-...)
AI_MODEL=openrouter/openrouter/free

# --- Usage guardrails ---
MAX_SESSIONS_PER_DAY=20

# --- Voice (Vapi). Optional: without these keys the Voice format is disabled and text mode is unaffected. ---
VAPI_PRIVATE_KEY=                  # server only: creates/deletes the per-session assistant
NEXT_PUBLIC_VAPI_PUBLIC_KEY=       # browser: starts the web call
VAPI_WEBHOOK_SECRET=               # any long random string; Vapi echoes it in X-Vapi-Secret
VAPI_VOICE_ID=Elliot
# Public origin Vapi can reach for the webhook + custom-LLM endpoint. Defaults to BETTER_AUTH_URL.
# Local dev needs a tunnel (e.g. ngrok/cloudflared): APP_URL=https://<tunnel>
APP_URL=
